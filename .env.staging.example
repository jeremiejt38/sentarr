# Sentarr — environnement de staging/test sur une seule bibliotheque Plex
# 1. Copier ce fichier en .env.staging
# 2. Remplir PLEX_TOKEN (Plex Web > Settings > General > Advanced > Show Token)
# 3. Adapter LIBRARIES_FILTER avec le nom EXACT d'une bibliotheque Plex
# 4. Lancer: docker compose -f docker-compose.staging.yml up --build -d

PLEX_URL=http://192.168.100.133:32400
PLEX_TOKEN=<TON_TOKEN_PLEX>
PLEX_LOG_PATH=/var/log/plex/Plex Media Server.log

# Une seule bibliotheque pour le test, par exemple "Films" ou "Films 4K"
LIBRARIES_FILTER=Films

# Pas de rescan complet : ne traite que les nouveaux items en cours
RETRO_SCAN=false

# DB isolee pour ne pas polluer la base de production
DATABASE_URL=sqlite:///app/data/sentarr-staging.db

LOG_LEVEL=DEBUG
POLL_INTERVAL_SECONDS=300
LOG_TAIL_INTERVAL_SECONDS=5
HISTORY_RETENTION_DAYS=90
PLEX_PASS_ENABLED=auto

# Auth desactivee en staging
AUTH_MODE=none
SECRET_KEY=change-me-in-production
SENTARR_ADMIN_API_KEY=

# Valeurs par defaut, adapte si tu as configure des clients *arr
RADARR_URLS=[]
SONARR_URLS=[]
DOWNLOAD_CLIENTS=[]
BAZARR_INSTANCES=[]
PROWLARR_INSTANCES=[]
NOTIFICATION_CHANNELS=[]
