# ============================================================
# Sentarr — Exemple de configuration
# Copier ce fichier en .env et remplir les valeurs réelles.
# NE JAMAIS COMMITTER .env OU DES SECRETS.
# ============================================================

# ------------------------------------------------------------------
# Plex (obligatoire V1)
# ------------------------------------------------------------------
# Serveur unique (legacy) :
PLEX_URL=http://plex:32400
PLEX_TOKEN=change_me
PLEX_LOG_PATH=/var/log/plex/Plex Media Server.log

# Multi-serveur (V3) — JSON array, prioritaire sur les variables ci-dessus :
# PLEX_SERVERS=[{"name":"main","url":"http://plex:32400","token":"...","log_path":"/var/log/plex/Plex Media Server.log"},{"name":"remote","url":"http://plex2:32400","token":"..."}]
PLEX_SERVERS=[]

# ------------------------------------------------------------------
# Application (optionnel V1)
# ------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/sentarr.db
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=60
LOG_TAIL_INTERVAL_SECONDS=5
HISTORY_RETENTION_DAYS=30
RETRO_SCAN=true

# Liste de noms de bibliothèques à surveiller, séparés par des virgules.
# Laisser vide pour surveiller toutes les bibliothèques movie/show trouvées.
LIBRARIES_FILTER=

# auto | true | false
# auto : tente de détecter si le serveur Plex dispose de Plex Pass.
PLEX_PASS_ENABLED=auto

HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------
# Acquisition — Radarr / Sonarr (V2)
# ------------------------------------------------------------------
# Format JSON : [{"name":"radarr-1080p","url":"http://radarr:7878","api_key_env":"RADARR_1080P_API_KEY","profile_label":"1080p"}]
RADARR_URLS=[]
SONARR_URLS=[]
# Clés API correspondant aux valeurs de api_key_env ci-dessus
# RADARR_1080P_API_KEY=change_me
# SONARR_1080P_API_KEY=change_me
ARR_POLL_INTERVAL_SECONDS=60

# Seuils d'alerte par étape (minutes, 0 = désactivé)
ALERT_THRESHOLD_SEARCHED=60
ALERT_THRESHOLD_DOWNLOADING=30
ALERT_THRESHOLD_IMPORTING=15
ALERT_THRESHOLD_PLEX_OVERALL=60

# ------------------------------------------------------------------
# Clients de téléchargement (V2)
# ------------------------------------------------------------------
# Format JSON : [{"type":"qbittorrent","name":"qbt","url":"http://qbittorrent:8080","username":"admin","password_env":"QBT_PASSWORD"}]
# ou [{"type":"transmission","name":"tr","url":"http://transmission:9091","username":"admin","password_env":"TR_PASSWORD"}]
DOWNLOAD_CLIENTS=[]
# QBT_PASSWORD=change_me
# TR_PASSWORD=change_me
HEALTH_THRESHOLD_WARNING=80
HEALTH_THRESHOLD_CRITICAL=50

# ------------------------------------------------------------------
# Notifications multi-canaux (V3)
# ------------------------------------------------------------------
# Format JSON Apprise : [{"name":"discord","url":"discord://...","events":["alert_triggered"]}]
NOTIFICATION_CHANNELS=[]

# ------------------------------------------------------------------
# Authentification (V3)
# ------------------------------------------------------------------
# none | api_key | forms | external
AUTH_MODE=none
# Clé API admin bootstrap (créée automatiquement au démarrage si AUTH_MODE != none)
# SENTARR_ADMIN_API_KEY=change_me

# ------------------------------------------------------------------
# Extensions multi-instance (V3)
# ------------------------------------------------------------------
# Bazarr : [{"name":"bazarr-main","url":"http://bazarr:6767","api_key":"..."}]
BAZARR_INSTANCES=[]
# Prowlarr : [{"name":"prowlarr-main","url":"http://prowlarr:9696","api_key":"..."}]
PROWLARR_INSTANCES=[]

# ------------------------------------------------------------------
# Métriques Prometheus / Grafana (V3)
# ------------------------------------------------------------------
METRICS_ENABLED=false
METRICS_PORT=8000
METRICS_PATH=/metrics
ANALYTICS_RETENTION_DAYS=90

# ------------------------------------------------------------------
# PostgreSQL (optionnel)
# ------------------------------------------------------------------
# Décommenter pour utiliser PostgreSQL à la place de SQLite.
# POSTGRES_PASSWORD=changeme
# Puis lancer avec :
#   docker compose -f docker/docker-compose.yml -f docker/docker-compose.postgres.yml up -d
